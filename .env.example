# ---- Site ----
PORT=3000
BASE_URL=http://localhost:3000
SITE_NAME=DanGida
SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
DEFAULT_COUNTRY_CODE=234
# Comma separated phone numbers that are always admins (international format, digits only)
ADMIN_PHONES=2348012345678

# ---- WhatsApp Cloud API (Meta) : OTP login + manage listings from WhatsApp ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Any string you choose; paste the same value in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, used to verify webhook signatures
WHATSAPP_APP_SECRET=
# Name of your approved "authentication" template (required to message users first)
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en

# ---- Paystack : pay-to-view, escrow, easy-buy instalments ----
PAYSTACK_SECRET_KEY=

# ---- Push notifications (auto-generated and stored if left empty) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Android app (Play Store) : see android/README.md ----
ANDROID_PACKAGE=
# SHA-256 fingerprint(s) of the app signing key, comma separated
ANDROID_SHA256=

# ---- Optional: auto-post new listings to your social pages ----
FB_PAGE_ID=
FB_PAGE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
