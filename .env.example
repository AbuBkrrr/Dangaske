# ---- Site ----
PORT=3000
BASE_URL=http://localhost:3000
SITE_NAME=Dangaske Real Estate
COMPANY_NAME=Dangaske Real Estate
RC_NUMBER=8511141
SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
DEFAULT_COUNTRY_CODE=234
# Comma separated phone numbers that are always admins (international format, digits only)
ADMIN_PHONES=2348037572052,2348161304050

# ---- WhatsApp Cloud API (Meta) : OTP login + manage listings from WhatsApp ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Any string you choose; paste the same value in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, used to verify webhook signatures
WHATSAPP_APP_SECRET=
# Name of your approved "authentication" template (required to message users first)
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en

# ---- Email (SMTP) : codes, receipts and alerts for members who add an email ----
# On cPanel hosting: create a mailbox (e.g. no-reply@your-domain) and use its details here
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Hourly jobs on shared hosting (see docs/DEPLOY-WHOGOHOST.md) ----
CRON_KEY=

# Private TEST server only: allow the simulated checkout while NODE_ENV=production. NEVER on the public site.
ALLOW_DEMO_PAYMENTS=

# ---- PayScrow: escrow for property purchases (see docs/PAYSCROW.md) ----
PAYSCROW_API_KEY=
PAYSCROW_WEBHOOK_SECRET=
# PAYSCROW_BASE_URL=https://api.payscrow.net

# ---- Paystack : pay-to-view, escrow, easy-buy instalments ----
PAYSTACK_SECRET_KEY=

# ---- Push notifications (auto-generated and stored if left empty) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Android app (Play Store) : see android/README.md ----
ANDROID_PACKAGE=
# SHA-256 fingerprint(s) of the app signing key, comma separated
ANDROID_SHA256=

# ---- Optional: auto-post new listings to your social pages ----
FB_PAGE_ID=
FB_PAGE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
