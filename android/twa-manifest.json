  "webManifestUrl": "https://YOUR-DOMAIN.com/manifest.webmanifest",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "minSdkVersion": 23,
  "enableNotifications": true,
  "fallbackType": "customtabs",
  "signingKey": { "path": "./android.keystore", "alias": "dangida" },
  "shortcuts": [
    { "name": "Browse properties", "shortName": "Browse", "url": "/listings", "chosenIconUrl": "https://YOUR-DOMAIN.com/icon-192.png" },
    { "name": "My inspections", "shortName": "Inspections", "url": "/dashboard?tab=inspections", "chosenIconUrl": "https://YOUR-DOMAIN.com/icon-192.png" }
