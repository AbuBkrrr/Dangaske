{
  "packageId": "ng.dangaske.dangida",
  "host": "YOUR-DOMAIN.com",
  "name": "DanGida",
  "launcherName": "DanGida",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0f3d2e",
  "navigationColor": "#0f3d2e",
  "backgroundColor": "#faf7f0",
  "startUrl": "/?source=app",
  "iconUrl": "https://YOUR-DOMAIN.com/icon-512.png",
